{
  "_comment": "모든 작품에 공통으로 적용하는 AI 문체 습관 패턴. 작품별 style_patterns.json에서 같은 id로 limit/advice를 덮어쓰거나 \"disabled\": true로 끌 수 있다.",
  "baseline": {
    "_source": "기본값(작품별 기준선으로 덮어쓸 것)",
    "narration_avg_len": 32.0,
    "narration_avg_len_warn": 45.0,
    "multi_sentence_paragraphs_warn": 6
  },
  "patterns": [
    {
      "id": "punch-formula",
      "label": "단언 뒤 한 줄 뒤집기 ('물론 ~ 기준으로.')",
      "regex": "^물론 [^\\n]{0,20}(기준으로|의미였다|비유적인)[^\\n]*$",
      "limit": 0,
      "advice": "펀치라인 공식. 빼거나 구체적인 상황 묘사로 바꾸기."
    },
    {
      "id": "then-cliche",
      "label": "'그때였다.' 상투 전환",
      "regex": "^그때였다\\.$",
      "limit": 0,
      "advice": "삭제하고 바로 사건으로 들어가기."
    },
    {
      "id": "not-a-but-b",
      "label": "'A가 아니었다. B였다' 대구",
      "regex": "아니었다\\.\\n+[^\\n]{1,40}였다\\.",
      "limit": 1,
      "advice": "기획 기준 §9 주의 패턴."
    },
    {
      "id": "precisely",
      "label": "'정확히는' 자기 정정",
      "regex": "정확히는",
      "limit": 1,
      "advice": "A라고 했다가 B로 고치는 구조 반복 주의."
    },
    {
      "id": "that-moment",
      "label": "'그 순간 / 깨달았다'",
      "regex": "(그 순간|깨달았다)",
      "limit": 1,
      "advice": "깨달음 예고 문장은 사건을 직접 보여 주는 것으로 대체."
    },
    {
      "id": "number-echo",
      "label": "숫자만 있는 문단 ('87%.')",
      "regex": "^\\d+(\\.\\d+)?%\\.$",
      "limit": 0,
      "advice": "상대가 말한 숫자를 한 줄로 따라 하지 말고 감정 섞인 반응으로 받기."
    },
    {
      "id": "wait",
      "label": "'잠깐'",
      "regex": "잠깐",
      "limit": 3,
      "advice": "초반 원고에서 과다했던 리듬 단어."
    },
    {
      "id": "good-alone",
      "label": "'좋아.' 단독 문단",
      "regex": "^'?좋아\\.'?$",
      "limit": 2,
      "advice": "다짐/정리 박자 반복 주의."
    },
    {
      "id": "silence-line",
      "label": "침묵 줄 ('…….')",
      "regex": "^['\"]?…+\\.?['\"]?$",
      "limit": 4,
      "advice": "침묵 줄은 한 화 3~4회 이하. 바로 뒤 서술에서 침묵을 또 설명하면 중복."
    },
    {
      "id": "only-emphasis",
      "label": "한 단어 강조 문단 ('정말로.')",
      "regex": "^(정말|정말로|진짜로)\\.$",
      "limit": 0,
      "advice": "'정말로. / 엄청나게 ~' 강조 리듬은 전형적인 AI 습관."
    },
    {
      "id": "she",
      "label": "'그녀' 사용",
      "regex": "그녀",
      "limit": null,
      "advice": "1인칭 화자가 가족·가까운 인물을 '그녀'로 부르면 번역투. 이름/호칭/주어 생략 검토. (정보용)"
    },
    {
      "id": "summary-so",
      "label": "'그렇게 나는 ~' 요약",
      "regex": "^그렇게 나는",
      "limit": 1,
      "advice": "장면 끝 요약·다짐 문단 주의."
    },
    {
      "id": "cliche-mock",
      "label": "상투 비유 ('~를 비웃듯')",
      "regex": "비웃듯",
      "limit": 0,
      "advice": "선택 수정."
    },
    {
      "id": "feeling-summary",
      "label": "감정 요약 ('이상하게 기분이 좋았다' 등)",
      "regex": "(이상하게 (기분이|그 말이|마음이)|이상한 기분|묘한 기분|가슴이 벅차|마음에 들었다\\.$)",
      "limit": 1,
      "advice": "감정을 해설하지 말고 행동/대사로."
    },
    {
      "id": "announce",
      "label": "예고형 전환 ('결정적인 장면이 왔다')",
      "regex": "(결정적인 (장면|증거|순간)|마침내 [^\n]{0,30}발견했다)",
      "limit": 0,
      "advice": "다음 장면의 의미를 미리 해설하지 말고 행동으로 바로 진입."
    }
  ],
  "spacing_suspects": [
    "한결과",
    "될셈",
    "할셈",
    "인셈",
    "것같",
    "거같",
    "는거지",
    "는건 ",
    "한거 ",
    "수있",
    "할 수록",
    "투성이었다",
    "내려다 봤다",
    "지 못 하",
    "또 한 ",
    "융합 할",
    "하는거"
  ]
}
